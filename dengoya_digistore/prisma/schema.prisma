// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(uuid())
  customerEmail   String
  amount          Float
  currency        String   @default("XAF")
  status          String   @default("PENDING") // PENDING, PAID, DELIVERED, REFUND_REQUESTED
  items           String   // JSON string of items bought
  proofPath       String?  // Path to the proof image (if delivered)
  transactionId   String?  // Flutterwave transaction ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
